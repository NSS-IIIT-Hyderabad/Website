# Production Environment Variables for NSS IIITH Website

# API Configuration
API_ENV=production
API_PORT=8000

# Database Configuration
MONGODB_URL=mongodb://admin:password123@mongodb:27017/nss_db?authSource=admin
MONGODB_DB_NAME=nss_db

# Redis Configuration
REDIS_URL=redis://redis:6379

# Frontend Configuration
# NOTE: this is overridden to a relative "/api" path directly in
# docker-compose.prod.yml, since NEXT_PUBLIC_* vars are read by the
# browser and must resolve against the public site origin, not an
# internal docker hostname.
NEXT_PUBLIC_API_URL=http://nginx/api
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
# Cookies must be Secure once served over HTTPS in production.
SECURE_COOKIES=true

# CAS Login Configuration
# SERVICE_URL/FRONTEND_URL must be the public, internet-facing URL of this
# deployment (through the nginx reverse proxy) - not a docker-internal
# hostname or localhost - or CAS ticket validation and post-login redirects
# will silently fail for real users. Replace with your actual domain.
CAS_SERVER_URL=https://login.iiit.ac.in/cas/
SERVICE_URL=https://nss.iiit.ac.in/api/login
FRONTEND_URL=https://nss.iiit.ac.in
FILES_BASE_URL=https://nss.iiit.ac.in/api/uploads

# CORS Configuration
ALLOWED_ORIGINS=https://nss.iiit.ac.in

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/uploads
